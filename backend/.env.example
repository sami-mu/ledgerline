# Copy to backend/.env and fill in. Never commit the real .env file.

# SQLite file used for storage (created on first start)
DATABASE_URL=sqlite:///./invoices.db

# Origin of the frontend dev server, for CORS
CORS_ORIGINS=http://localhost:5173

# SMTP settings. Any provider works (Resend, Brevo, Mailtrap, Gmail app password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# "starttls" for port 587, "ssl" for port 465, "none" for local test servers
SMTP_SECURITY=starttls
MAIL_FROM_ADDRESS=invoices@example.com
MAIL_FROM_NAME=Fieldnote Studio
